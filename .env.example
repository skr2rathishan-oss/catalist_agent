# Copy to .env and fill in. Never commit .env.
# One NVIDIA key is used for both answer generation and embeddings.
NVIDIA_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
EMBEDDING_DIMENSIONS=4096
EMBEDDING_BATCH_SIZE=16
# Adjust to your NVIDIA endpoint's current account quota.
EMBEDDING_REQUESTS_PER_MINUTE=10
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
GENERATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# If the selected generation model returns 404, explicitly select an alternative:
# GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
# Check the configured model: python scripts/run.py --check-generation
GENERATION_MAX_TOKENS=2048
GENERATION_REQUESTS_PER_MINUTE=10
GENERATION_TIMEOUT=120
GENERATION_MAX_RETRIES=2
